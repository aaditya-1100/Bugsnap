{
  "name": "bugsnap",
  "version": "0.1.0",
  "private": true,
  "description": "Visual bug reporting SaaS — capture, annotate, report.",
  "scripts": {
    "build": "pnpm --filter @bugsnap/web build",
    "dev:web": "pnpm --filter @bugsnap/web dev",
    "dev:ext": "pnpm --filter @bugsnap/extension dev",
    "build:web": "pnpm --filter @bugsnap/web build",
    "build:ext": "pnpm --filter @bugsnap/extension build",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}
